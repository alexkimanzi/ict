# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign and verify JWT authentication tokens.
JWT_SECRET="replace-with-a-long-random-secret-key"

# PORT: HTTP server port (AI Studio requires 3000)
PORT=3000

# Transactional Email Service (SendGrid or Mailgun)
EMAIL_PROVIDER="sendgrid"
EMAIL_FROM="ICT Helpdesk <noreply@ictportal.edu>"
SENDGRID_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# SMS / Phone Number Notifications (Twilio)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# PostgreSQL connection settings (for external PostgreSQL deployment via database/schema.sql)
PGHOST="localhost"
PGPORT=5432
PGDATABASE="ict_helpdesk_db"
PGUSER="postgres"
PGPASSWORD="your_postgres_password"
